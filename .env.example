# Set a unique, high-entropy value before deploying outside local development.
JWT_SECRET=replace-with-a-long-random-secret
PORT=3001
# Local development connection (matches compose.yaml).
DATABASE_URL=postgres://mediclaim:mediclaim@localhost:5432/mediclaim
# Set DATABASE_SSL=true when your managed PostgreSQL provider requires SSL.
DATABASE_SSL=false
# Optional alternate JSON source path for the one-time migration command.
# MEDICLAIM_JSON_IMPORT_PATH=C:/path/to/mediclaim.json
