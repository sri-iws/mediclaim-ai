# Set a unique, high-entropy value before deploying outside local development.
JWT_SECRET=replace-with-a-long-random-secret
PORT=3001
# SQLite file path; relative paths are resolved from the repository root.
SQLITE_DB_PATH=server/data/mediclaim.sqlite
# Optional CPT price ranges: only enable for a source you are licensed/authorized to use.
# CSV columns: code,reference_min,reference_max,currency (optional: source_note).
# CPT_PRICING_REFERENCE_CSV=/app/references/cpt_pricing_reference.csv
# CPT_PRICING_REFERENCE_SOURCE=Your authorized schedule name
# CPT_PRICING_REFERENCE_VERSION=2026-release
CPT_PRICING_REFERENCE_AUTHORIZED=false
# Optional alternate JSON source path for the one-time migration command.
# MEDICLAIM_JSON_IMPORT_PATH=C:/path/to/mediclaim.json
